{
  "expo": {
    "name": "Phone Box",
    "slug": "phonebox",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "phonebox",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.emahmaker.phonebox",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "bluetooth-central",
          "bluetooth-central"
        ],
        "NSBluetoothAlwaysUsageDescription": "Phone Box connects to your box over Bluetooth to show focus stats and light up the box when an important call comes in.",
        "NSBluetoothPeripheralUsageDescription": "Phone Box connects to your box over Bluetooth.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-dev-client",
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": true,
          "modes": [
            "central"
          ],
          "bluetoothAlwaysPermission": "Phone Box connects to your box over Bluetooth to show focus stats and alert it to important calls."
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.1003347406984-c0c1v113pb68t5oclv2cmc1lgr21mnd9"
        }
      ],
      "expo-apple-authentication",
      "expo-font",
      "expo-notifications"
    ],
    "android": {
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT"
      ],
      "package": "com.phonebox.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1a1a1c"
      }
    },
    "extra": {
      "eas": {
        "projectId": "95e39362-3a53-4150-afed-77bcde196369"
      }
    },
    "owner": "emah888"
  }
}

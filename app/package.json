{
  "name": "phonebox-app",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild --clean",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "android": "expo run:android"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^1.23.1",
    "@react-native-google-signin/google-signin": "^13.3.1",
    "background-wake": "file:./modules/background-wake",
    "buffer": "^6.0.3",
    "call-observer": "file:./modules/call-observer",
    "expo": "~52.0.0",
    "expo-apple-authentication": "~7.1.3",
    "expo-crypto": "~14.0.2",
    "expo-dev-client": "~5.0.0",
    "expo-secure-store": "~14.0.1",
    "expo-status-bar": "~2.0.0",
    "firebase": "10.14.1",
    "react": "18.3.1",
    "react-native": "0.76.5",
    "react-native-ble-plx": "^3.2.1",
    "react-native-get-random-values": "^1.11.0",
    "react-native-safe-area-context": "4.12.0",
    "react-native-svg": "15.8.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~18.3.12",
    "jest": "^29.7.0",
    "jest-expo": "~52.0.0",
    "typescript": "~5.3.3"
  },
  "expo": {
    "autolinking": {
      "nativeModulesDir": "./modules"
    }
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/ios/",
      "/android/"
    ]
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}

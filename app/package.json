{
  "name": "phonebox-app",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild --clean",
    "postinstall": "patch-package",
    "test": "jest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests",
    "android": "expo run:android"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "background-wake": "file:./modules/background-wake",
    "buffer": "^6.0.3",
    "call-observer": "file:./modules/call-observer",
    "expo": "~57.0.24",
    "expo-apple-authentication": "~57.0.2",
    "expo-constants": "~57.0.19",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-notifications": "~57.0.20",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "firebase": "10.14.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-ble-plx": "^3.5.1",
    "react-native-get-random-values": "^1.11.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "zustand": "^5.0.2"
  },
  "overrides": {
    "@react-native-async-storage/async-storage": "2.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@firebase/rules-unit-testing": "^3.0.4",
    "@types/jest": "^29.5.14",
    "@types/node": "^26.4.0",
    "@types/react": "~19.2.4",
    "@types/react-test-renderer": "^19.1.0",
    "babel-preset-expo": "~57.0.10",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "patch-package": "^8.0.1",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "expo": {
    "autolinking": {
      "nativeModulesDir": "./modules"
    }
  },
  "jest": {
    "projects": [
      {
        "displayName": "app",
        "preset": "jest-expo",
        "setupFiles": [
          "<rootDir>/jest.setup.js"
        ],
        "testPathIgnorePatterns": [
          "/node_modules/",
          "/ios/",
          "/android/",
          "<rootDir>/tests/firestore-rules/"
        ],
        "transformIgnorePatterns": [
          "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|firebase|@firebase))"
        ]
      },
      {
        "displayName": "firestore-rules",
        "testEnvironment": "node",
        "testMatch": [
          "<rootDir>/tests/firestore-rules/**/*.test.ts"
        ],
        "transform": {
          "^.+\\.tsx?$": [
            "babel-jest",
            {
              "configFile": false,
              "babelrc": false,
              "presets": [
                [
                  "@babel/preset-env",
                  {
                    "targets": {
                      "node": "current"
                    }
                  }
                ],
                "@babel/preset-typescript"
              ]
            }
          ]
        },
        "transformIgnorePatterns": [
          "node_modules/(?!(firebase|@firebase))"
        ]
      }
    ]
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function hasOnlyUserFields(data) {
      return data.keys().hasOnly(['email', 'displayName', 'photoURL', 'createdAt', 'updatedAt']);
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
                    && hasOnlyUserFields(request.resource.data)
                    && request.resource.data.createdAt == request.time;
      // Same field allow-list as create, plus createdAt pinned immutable --
      // otherwise update had no shape/immutability checks at all.
      allow update: if isOwner(uid)
                    && hasOnlyUserFields(request.resource.data)
                    && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isOwner(uid); // part of the account-deletion path, §5

      match /sessions/{sessionId} {
        allow read: if isOwner(uid);
        // Create-only for the event-log fields: startedAt/plannedS/actualS/outcome
        // describe something that already happened and must never be rewritten.
        // `topic` (the session's label) is the one exception -- see the scoped
        // `update` rule below, which is the backend for relabeling a session
        // from the dashboard or the app's own CalendarScreen retag flow.
        allow create: if isOwner(uid)
                      && request.resource.data.keys().hasOnly(['startedAt', 'plannedS', 'actualS', 'outcome', 'topic', 'topicUpdatedAt'])
                      && request.resource.data.outcome in ['completed', 'overridden']
                      && request.resource.data.startedAt is int && request.resource.data.startedAt >= 0
                      && request.resource.data.plannedS is int && request.resource.data.plannedS >= 0
                      && request.resource.data.actualS is int && request.resource.data.actualS >= 0
                      // 200-char cap mirrors TopicPicker.tsx's TextInput maxLength -- without it
                      // a client could pad this field arbitrarily (resource-exhaustion risk).
                      && (!('topic' in request.resource.data)
                          || (request.resource.data.topic is string && request.resource.data.topic.size() <= 200))
                      && (!('topicUpdatedAt' in request.resource.data) || request.resource.data.topicUpdatedAt is int);
        // Relabel-only: every other field of an already-created session doc
        // stays immutable (diff().affectedKeys() catches an attempt to sneak
        // a change to startedAt/plannedS/actualS/outcome in alongside a
        // legitimate topic edit). topicUpdatedAt is a client logical clock
        // (same pattern as settings/app's updatedAt below) used by
        // sync/sessionMerge.ts's last-write-wins merge, so a dashboard edit
        // and an in-app retag of the same session resolve deterministically
        // instead of one silently clobbering the other on next sync; it must
        // strictly increase so a client can't replay a stale edit over a
        // newer one.
        allow update: if isOwner(uid)
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['topic', 'topicUpdatedAt'])
                      && (!('topic' in request.resource.data)
                          || (request.resource.data.topic is string && request.resource.data.topic.size() <= 200))
                      && request.resource.data.topicUpdatedAt is int
                      && request.resource.data.topicUpdatedAt > (('topicUpdatedAt' in resource.data) ? resource.data.topicUpdatedAt : -1);
        allow delete: if false; // integrity: a session can be relabeled, never erased, even by the owner
      }

      match /settings/app {
        // updatedAt is a client-side logical clock (see firestoreSync.ts's
        // last-write-wins compare), not a server timestamp -- type-check it
        // rather than pinning it to request.time.
        //
        // read and write are split because request.resource only exists on
        // writes -- referencing it in a combined read+write rule denies every
        // read (rules errors evaluate to deny), which is why the dashboard's
        // getDoc() on this doc always came back permission-denied.
        allow read: if isOwner(uid);
        // create/update are split from delete for the same reason: request.resource
        // is null on delete, so a shape-validated condition can never cover that verb
        // (it would raise and rules errors evaluate to deny). That silently made this
        // doc undeletable, breaking deleteAllUserData()'s settings cleanup on account
        // deletion (firestoreSync.ts).
        allow create, update: if isOwner(uid)
                     && request.resource.data.keys().hasOnly(
                          ['themeMode', 'accent', 'callAlertsEnabled', 'customLabels', 'updatedAt'])
                     && request.resource.data.updatedAt is int
                     // Rules can't validate each array element's field lengths (no
                     // iteration over list-of-maps), so this bounds the catalog size;
                     // per-label name length is capped client-side (customLabels.ts).
                     && request.resource.data.customLabels.size() <= 40;
        allow delete: if isOwner(uid);
      }

      match /devices/{deviceId} {
        // Read + delete only: app code never creates/updates device docs
        // today (firestoreSync.ts's deleteAllUserData only enumerates and
        // deletes them). Add create/update here once a real device-doc
        // schema exists to validate against.
        allow read, delete: if isOwner(uid);
      }

      match /pushTokens/{tokenId} {
        // Where this user's devices register to receive server-sent
        // reminders (functions/src/index.ts's sendDueReminders reads these
        // with admin credentials, which bypass these rules -- what is gated
        // here is only what a CLIENT may write about its own devices).
        //
        // Two transports, deliberately kept in one collection: 'expo' is the
        // phone app's Expo push token, 'webpush' is an FCM registration
        // token minted by a dashboard tab. The server treats them
        // differently on the way out, but they are the same thing here --
        // an address this user has asked to be reached at.
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
                              && request.resource.data.keys().hasOnly(
                                   ['transport', 'token', 'platform', 'localReminderIds',
                                    'suppressedReminderIds', 'createdAt', 'updatedAt'])
                              && request.resource.data.transport in ['expo', 'webpush']
                              && request.resource.data.token is string
                              // FCM registration tokens run to ~200 chars and
                              // Expo's to ~50; the cap is generous enough for
                              // both to grow, tight enough that this field
                              // can't be used as free storage.
                              && request.resource.data.token.size() > 0
                              && request.resource.data.token.size() <= 512
                              && request.resource.data.updatedAt is int
                              && (!('platform' in request.resource.data)
                                  || request.resource.data.platform in ['ios', 'android', 'web'])
                              // The duplicate-suppression list (see
                              // functions/src/reminders.ts's PushTokenDoc).
                              // Rules can't check each element's length, so
                              // this bounds the list itself; the app caps it
                              // at MAX_SESSION_REMINDERS on its own side.
                              && (!('localReminderIds' in request.resource.data)
                                  || (request.resource.data.localReminderIds is list
                                      && request.resource.data.localReminderIds.size() <= 50))
                              // Its counterpart: reminders this device
                              // silenced for quiet hours, which the server
                              // must also not push (same PushTokenDoc).
                              // Bounded separately and identically -- one
                              // device's two lists are each at most the
                              // reminders it could have scheduled.
                              && (!('suppressedReminderIds' in request.resource.data)
                                  || (request.resource.data.suppressedReminderIds is list
                                      && request.resource.data.suppressedReminderIds.size() <= 50));
      }

      match /scheduledSessions/{planId} {
        // One planned focus session, written by either client and read by
        // the reminder job. Individual documents rather than one array field
        // (the shape goals/config uses) specifically so the backend can find
        // what is due with a collection-group query instead of scanning
        // every user -- see functions/src/index.ts's readDueReminders.
        //
        // `notifiedAt` is the one field the SERVER writes (admin credentials
        // bypass these rules). A client may still write it as `null`, which
        // is what re-arms an edited plan -- and must, because Firestore
        // cannot query for an absent field, so every document has to carry
        // an explicit null until it is sent.
        //
        // read/create/update/delete are split into separate rules for the
        // same reason every other block in this file splits them:
        // request.resource is null on read and delete, so a shape-validated
        // condition covering those verbs would raise -- and a rules error
        // evaluates to deny, silently making the document unreadable and
        // undeletable (exactly the bug settings/app's own comment records).
        function validPlan() {
          let d = request.resource.data;
          return d.keys().hasOnly(
                   ['date', 'time', 'fireAtMs', 'timeLabel', 'tz', 'topic', 'leadMinutes',
                    'plannedS', 'note', 'done', 'notifiedAt', 'updatedAt'])
                 && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
                 && d.time is string && d.time.matches('^[0-9]{2}:[0-9]{2}$')
                 // The only field the backend queries on, so the only one
                 // whose type is load-bearing for anything but display.
                 && d.fireAtMs is int
                 // Pre-formatted by the client that created the plan, because
                 // only it knows the user's locale (functions/src/reminders.ts
                 // explains why the server doesn't re-derive it). Capped so a
                 // notification body can't be padded arbitrarily.
                 && d.timeLabel is string && d.timeLabel.size() <= 20
                 && d.leadMinutes is int && d.leadMinutes >= 0 && d.leadMinutes <= 1440
                 && d.done is bool
                 && d.updatedAt is int
                 && (d.notifiedAt == null || d.notifiedAt is int)
                 // 200 chars mirrors the sessions block's own topic cap, and
                 // TopicPicker.tsx's TextInput maxLength behind both.
                 && (!('topic' in d) || d.topic == null
                     || (d.topic is string && d.topic.size() <= 200))
                 // Mirrors MAX_NOTE_LENGTH in app/src/schedule/scheduledSessions.ts.
                 && (!('note' in d) || (d.note is string && d.note.size() <= 120))
                 && (!('plannedS' in d) || (d.plannedS is int && d.plannedS > 0 && d.plannedS <= 86400))
                 && (!('tz' in d) || (d.tz is string && d.tz.size() <= 64));
        }

        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && validPlan();
        allow delete: if isOwner(uid);
      }

      match /goals/config {
        // Single doc holding the user's focus-time goals (RFC-extension
        // contract: users/{uid}/goals/config), settable from both this app
        // and the website dashboard. updatedAt is a client-side logical
        // clock -- same reasoning as settings/app above, so it's type-checked
        // rather than pinned to request.time.
        //
        // read is split from create/update for the same reason as
        // settings/app: request.resource only exists on writes, so
        // referencing it in a combined read+write rule denies every read
        // (rules errors evaluate to deny).
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
                              && request.resource.data.keys().hasOnly(['goals', 'updatedAt'])
                              && request.resource.data.updatedAt is int
                              && request.resource.data.goals is list
                              // Rules can't iterate a list-of-maps to validate each
                              // Goal entry's own fields (id length/uniqueness, topic
                              // length, targetS bounds, the "flexible goals" extension
                              // fields' own bounds -- daysOfWeek/targetSessions/notify/
                              // notifyAt, etc.) -- same limitation settings/app's
                              // customLabels comment notes above. Only the array's
                              // overall size is bounded here; per-goal field validation
                              // (including every extension field added after this rule
                              // was first written) is client-side in
                              // app/src/goals/goals.ts (MAX_GOALS/MAX_GOAL_ID_LENGTH/
                              // MAX_TOPIC_LENGTH/MAX_MONTHLY_TARGET_S/
                              // MAX_TARGET_SESSIONS/etc., mirrored in website/js/goals.js
                              // -- keep those numbers in sync with this cap).
                              && request.resource.data.goals.size() <= 20;
        // Delete is its own verb, not folded into the create/update rule
        // above: on a delete request.resource is null, so evaluating
        // request.resource.data.keys() against it raises a rules error, and
        // rules errors evaluate to deny -- that would make this doc
        // permanently undeletable and silently break deleteAllUserData's
        // account-deletion path. Same shape as the sessions block's own
        // verb split above.
        allow delete: if isOwner(uid); // part of the account-deletion path, §5
      }
      // Anything else under /goals/{docId} (any id other than "config")
      // falls through to the deny-by-default rule at the bottom of this
      // file -- intended: this feature only ever reads/writes the single
      // config doc.
    }

    // Public waitlist signups (website's landing-page form, script.js's
    // submit handler) -- the first unauthenticated write path in this whole
    // file. Every collection above is gated on isOwner(uid); this one has to
    // accept a write from a visitor who has never signed in, so there is no
    // uid to check against. That makes it the highest-abuse-surface rule
    // here, so it's deliberately the tightest:
    //   - create-only, exact 3-key allow-list (no room to smuggle an extra
    //     field in alongside a valid one), createdAt pinned to request.time
    //     (a client can't forge/backdate it -- same reasoning as
    //     users/{uid}'s createdAt), a basic email-shape regex, and a hard
    //     254-char length cap. The regex and length cap mirror script.js's
    //     own client-side check, but that check is a UX nicety a visitor's
    //     browser enforces on itself -- it proves nothing to the server, so
    //     the real boundary is asserted again here.
    //   - read: if false, unconditionally, even for a signed-in user. There
    //     is no per-doc owner field to check a read against (the entire
    //     point of this collection is that it's written by people who
    //     aren't signed in), so there is no isOwner(uid)-shaped condition
    //     that could ever scope a read safely -- "any authenticated user can
    //     read" would really mean "anyone with a Google account can
    //     enumerate every email address anyone has ever submitted." The only
    //     legitimate reads are out-of-band, via the Firebase console or an
    //     export job running under admin credentials, both of which bypass
    //     these rules entirely.
    //   - update, delete: if false -- a signup either gets created or it
    //     doesn't; there is no legitimate reason for a client to revise or
    //     remove one afterward.
    //
    // Defence in depth, front to back: App Check (website/js/appCheck.js,
    // wired in on every page that calls initializeApp) is now the PRIMARY
    // defence for this collection -- it makes Firestore reject a create
    // whose request doesn't carry a token proving it came from this site
    // running in a real browser, which is what stops a script hitting the
    // Firestore REST API directly with random doc IDs and made-up emails
    // from writing unlimited DISTINCT waitlist docs. It ships disabled by
    // default (see appCheck.js's header for why) until the project owner
    // registers a reCAPTCHA v3 provider in the Firebase console; nothing
    // below changes once that happens -- App Check enforcement is a console
    // setting and an SDK-side token, not a rules change.
    //
    // Behind that: DO NOT relax `update` here. The website derives each
    // doc's ID from a SHA-256 of the submitted email (script.js's
    // waitlistDocId) rather than letting addDoc mint a random one, so a
    // repeat signup is a write to an existing doc -- which Firestore
    // evaluates as `update`, and this rule denies. That denial IS the rate
    // limit on DUPLICATE signups specifically: it is what caps how many
    // times one already-seen address can be written, independent of
    // whether App Check above is active yet. It does nothing for distinct
    // addresses, which is exactly the gap App Check is there to close.
    // Allowing update would silently make repeat signups floodable again
    // with no visible failure anywhere, regardless of App Check's state.
    match /waitlist/{docId} {
      allow create: if request.resource.data.keys().hasOnly(['email', 'createdAt', 'source'])
                    && request.resource.data.email is string
                    && request.resource.data.email.size() <= 254
                    && request.resource.data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$')
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.source == 'website';
      allow read: if false;
      allow update, delete: if false;
    }

    // Deny-by-default: anything not explicitly matched above -- any other top-level
    // collection, any other user's uid path, any unauthenticated request -- is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

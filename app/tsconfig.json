{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "moduleResolution": "bundler",
    // On, and worth the friction. A refactor that moves a function to another
    // module leaves its imports behind in the file it came from, and nothing
    // else notices -- the code still compiles, still passes, and quietly
    // carries names it no longer uses. That is how a 2100-line file ends up
    // importing 36 things it never touches. In an app bundle the cost is
    // shipped bytes; the same habit on the firmware side costs RAM on a
    // microcontroller. Cheaper to never let it start.
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["jest"]
  },
  "include": ["**/*.ts", "**/*.tsx"],
  // tests/ is excluded here and typechecked by its own tsconfig instead: the
  // Firestore rules suite runs under plain Node (fs/path/__dirname to load
  // firestore.rules), which needs @types/node. Adding "node" to the `types`
  // above would hand Node globals to React Native app code as well, where
  // they don't exist at runtime -- tsc would then happily accept a
  // process.cwd() or Buffer in a screen that crashes on device.
  "exclude": ["node_modules", "ios", "android", "tests"]
}

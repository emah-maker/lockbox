# Copy to app/.env and fill in with your own Firebase project's values.
# These are client config, not secrets -- EXPO_PUBLIC_* is Expo's prefix for
# values that get embedded in the app bundle. Access control lives in
# firestore.rules, not in keeping these hidden.

# Firebase console -> Project settings -> General -> Your apps -> Web app
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Authentication -> Sign-in method -> Google -> Web SDK configuration
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# From the iOS app's GoogleService-Info.plist (CLIENT_ID)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

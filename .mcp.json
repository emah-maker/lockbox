{
  "mcpServers": {
    "claude-flow": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "ruflo@latest",
        "mcp",
        "start"
      ],
      "env": {
        "npm_config_update_notifier": "false",
        "CLAUDE_FLOW_MODE": "v3",
        "CLAUDE_FLOW_HOOKS_ENABLED": "true",
        "CLAUDE_FLOW_TOPOLOGY": "hierarchical-mesh",
        "CLAUDE_FLOW_MAX_AGENTS": "8",
        "CLAUDE_FLOW_MEMORY_BACKEND": "hybrid"
      },
      "autoStart": true
    },
    "cad-reader": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "cad-mcp-server"
      ],
      "env": {
        "npm_config_update_notifier": "false"
      },
      "autoStart": true
    },
    "build123d": {
      "command": "C:\\Users\\emah\\AppData\\Roaming\\Python\\Python314\\Scripts\\uv.exe",
      "args": [
        "tool",
        "run",
        "--python",
        "3.12",
        "build123d-mcp@latest"
      ],
      "autoStart": true
    }
  }
}
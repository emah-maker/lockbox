app/ios/
app/android/
app/.expo/

# Python
__pycache__/
*.pyc

# Claude Flow / agent tool runtime state
.swarm/
.claude-flow/
.playwright-mcp/
ruvector.db

# OS
.DS_Store
Thumbs.db

# Env / secrets
.env
.env.local
*.pem

# Firebase local deploy cache (firebase.json / .firebaserc stay tracked)
.firebase/

# Agent/tool scratch output
graphify-out/
.impeccable/
app/.agents/
app/.claude/

# Large local-only asset working dirs
V2 CAD/
Audits/

# Loose generated assets / media at repo root
/hero-top.png
/pricing-costbars.png
/pricing-revealed.png
/WhatsApp Video *.mp4

# FRAIM synced catalog (baseline content, re-synced from upstream).
# NOTE: fraim/ is currently TRACKED (874 files), so this pattern has no effect
# until those paths are untracked with:
#   git rm -r --cached fraim/
# Repo-specific overrides under fraim/personalized-employee/ are re-included below.
fraim/*
!fraim/personalized-employee/

# --- cmd.exe redirect-misparse junk files (2026-08-27) ---
# Root cause FIXED in .claude/settings.json + .claude/helpers/hook-entry.cjs
# (broken original: scripts/settings.json.pre-hook-fix.bak).
# No blanket ignore here on purpose: patterns broad enough to catch names like
# `0)` or `r.goalId)).toEqual(['g1'])` also swallow legitimate files such as
# Expo Router dynamic routes ([id].tsx) -- silently untracked is worse than
# visibly junk. Zero-byte junk shows up in `git status`; clean it with:
#   node scripts/clean-junk-files.js [--delete]

# Video build intermediates (regenerable; deliverables are the .webm/.mp4)
website/assets/video/*-master.mp4
website/assets/video/screen/*_frames/
website/assets/video/seeds/
/Base-marketing video.mp4

# Firebase emulator debug logs, dropped in the repo root by
# `firebase emulators:exec` -- which is now the normal way to run the
# Firestore rules suite (app/tests/firestore-rules), so these regenerate on
# every test run and would otherwise show up as untracked noise each time.
firestore-debug.log
firebase-debug.log
ui-debug.log
